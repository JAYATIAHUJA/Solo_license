{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "sololicense.api.app:app",
        "--port",
        "8000"
      ],
      "env": {
        "SOLO_DEMO_MODE": "1",
        "SOLO_LICENSE_DB": "data/preview.db",
        "SOLO_LEDGER_REPO": "data/preview-ledger"
      },
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "env": {
        "SOLO_API_URL": "http://127.0.0.1:8000"
      },
      "port": 5174
    }
  ]
}
