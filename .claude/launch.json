{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.api:app", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174"],
      "env": { "SOLO_API_URL": "http://127.0.0.1:8001" },
      "port": 5174
    }
  ]
}
