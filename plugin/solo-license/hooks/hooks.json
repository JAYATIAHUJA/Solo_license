{
  "description": "Solo License: refuse forbidden actions and loops before any tool runs, answer permission prompts from each action class's earned license, record outcomes, verify each turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/api/hooks/user-prompt",
            "timeout": 10,
            "headers": {
              "X-Solo-Hook-Key": "$SOLO_HOOK_KEY"
            },
            "allowedEnvVars": [
              "SOLO_HOOK_KEY"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/api/hooks/pre-tool",
            "timeout": 10,
            "headers": {
              "X-Solo-Hook-Key": "$SOLO_HOOK_KEY"
            },
            "allowedEnvVars": [
              "SOLO_HOOK_KEY"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/api/hooks/permission",
            "timeout": 10,
            "headers": {
              "X-Solo-Hook-Key": "$SOLO_HOOK_KEY"
            },
            "allowedEnvVars": [
              "SOLO_HOOK_KEY"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/api/hooks/post-tool",
            "timeout": 10,
            "headers": {
              "X-Solo-Hook-Key": "$SOLO_HOOK_KEY"
            },
            "allowedEnvVars": [
              "SOLO_HOOK_KEY"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/api/hooks/post-tool-failure",
            "timeout": 10,
            "headers": {
              "X-Solo-Hook-Key": "$SOLO_HOOK_KEY"
            },
            "allowedEnvVars": [
              "SOLO_HOOK_KEY"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/api/hooks/stop",
            "timeout": 150,
            "headers": {
              "X-Solo-Hook-Key": "$SOLO_HOOK_KEY"
            },
            "allowedEnvVars": [
              "SOLO_HOOK_KEY"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/api/hooks/subagent-start",
            "timeout": 10,
            "headers": {
              "X-Solo-Hook-Key": "$SOLO_HOOK_KEY"
            },
            "allowedEnvVars": [
              "SOLO_HOOK_KEY"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8000/api/hooks/subagent-stop",
            "timeout": 150,
            "headers": {
              "X-Solo-Hook-Key": "$SOLO_HOOK_KEY"
            },
            "allowedEnvVars": [
              "SOLO_HOOK_KEY"
            ],
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
